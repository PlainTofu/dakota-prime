{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "repositories": ["PlainTofu/dakota-prime"],
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "description": "Track updates to the Dakota source image",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/projectbluefin/dakota-gaming"],
      "pinDigests": true,
      "automerge": true
    }
  ]
}
